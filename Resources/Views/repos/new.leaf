#extend("base"):
  #export("title"): 新建仓库 - Gitke #endexport
  #export("body"):
    <div class="card">
      <h2>创建仓库</h2>
      #if(error):
        <p style="color:#b91c1c;">创建失败：#(error)</p>
      #endif
      <form method="post" action="/repos">
        <label>仓库名</label>
        <input name="name" required />

        <label>描述</label>
        <textarea name="description"></textarea>

        <label>可见性</label>
        <select name="visibility">
          <option value="public">public</option>
          <option value="private">private</option>
        </select>

        <label><input type="checkbox" name="initReadme" value="1" /> 初始化 README</label><br />
        <label><input type="checkbox" name="initGitignore" value="1" /> 初始化 .gitignore</label><br /><br />

        <button type="submit">创建</button>
      </form>
    </div>
  #endexport
#endextend
