<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>登录 - Gitke</title>
  <style>
    body { margin: 0; background: linear-gradient(135deg, #ecfeff, #f0f9ff); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    .box { max-width: 420px; margin: 100px auto; background: #fff; border-radius: 12px; padding: 24px; box-shadow: 0 16px 48px rgba(15,118,110,.15); }
    input { width: 100%; padding: 10px; margin-top: 8px; margin-bottom: 14px; border: 1px solid #d1d5db; border-radius: 8px; }
    button { width: 100%; padding: 10px; background: #0f766e; color: #fff; border: none; border-radius: 8px; }
    .err { color: #b91c1c; margin-bottom: 10px; }
  </style>
</head>
<body>
  <div class="box">
    <h2>Gitke 登录</h2>
    #if(error):
      <div class="err">#(error)</div>
    #endif
    <form method="post" action="/login">
      <label>用户名</label>
      <input name="username" required />
      <label>密码</label>
      <input type="password" name="password" required />
      <button type="submit">登录</button>
    </form>
  </div>
</body>
</html>
